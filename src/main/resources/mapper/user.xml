<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.pentagonUniv.domain.user.UserRepository">
    <select id="selectByUserNumber" resultType="com.example.pentagonUniv.domain.user.dto.PrincipalDto">
        SELECT *
        FROM pu_user
        WHERE user_number = #{userNumber}
    </select>

    <!--  로그인 성공시 세션 저장  -->
	<select id="findById" resultType="com.example.pentagonUniv.domain.user.dto.UserInfoDto">
		<![CDATA[SELECT * FROM pu_user WHERE id = #{userId}]]>
	</select>

    <!-- 현재 까지 등록된 학번 조회 -->
    <select id="findMaxSequence" resultType="int">
        SELECT 
            CAST(SUBSTRING(MAX(user_number), 7, 3) AS INTEGER) 
        FROM pu_user 
        WHERE 
            user_number LIKE CONCAT(#{year}, '%')
    </select>

    <!-- 학생 조회 -->
    <select id="findByAllStudentInfo" resultType="StudentInfoDto">
        SELECT *
        FROM pu_user
        WHERE user_type = 'STUDENT'
    </select>

    <!-- 교수 조회 -->
    <select id="findByAllProfessorInfo" resultType="ProfessorInfoDto">
        SELECT *
        FROM pu_user
        WHERE user_type = 'PROFESSOR'
    </select>

    <!-- 교직원 조회 -->
    <select id="findByAllStaffInfo" resultType="StaffInfoDto">
        SELECT *
        FROM pu_user
        WHERE user_type = 'STAFF'
    </select>
    
</mapper>